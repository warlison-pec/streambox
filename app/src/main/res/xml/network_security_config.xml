<?xml version="1.0" encoding="utf-8"?>
<!-- Permite http:// para servidores na rede local (ex.: http://192.168.1.16:8096). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
